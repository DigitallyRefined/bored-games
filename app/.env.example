# WebSocket URL of the API server. Defaults to a local dev server
# (ws://localhost:3001/ws, or ws://10.0.2.2:3001/ws on Android emulators).
# For a deployed API (e.g. Render), use:
# EXPO_PUBLIC_WS_URL=wss://bored-games-api.onrender.com/ws
# EXPO_PUBLIC_WS_URL=ws://192.168.1.10:3001/ws

# Shared secret used to sign player auth tokens. Must match AUTH_SECRET on
# the API server. If unset, both sides fall back to "bored-games-shared-secret".
# EXPO_PUBLIC_AUTH_SECRET=replace-me-with-the-api-auth-secret