# Shared secret used to sign player auth tokens.
# Must match EXPO_PUBLIC_AUTH_SECRET in the app.
AUTH_SECRET=replace-me-with-a-random-secret

# Railway injects PORT automatically; if running locally it defaults to 3001.
PORT=3001

# PostgreSQL connection. On Railway, reference these from the Postgres
# service instead of hardcoding, e.g.:
#   PGHOST=${{Postgres.PGHOST}}
#   PGPORT=${{Postgres.PGPORT}}
#   PGUSER=${{Postgres.PGUSER}}
#   PGPASSWORD=${{Postgres.PGPASSWORD}}
#   PGDATABASE=${{Postgres.PGDATABASE}}
PGHOST=localhost
PGPORT=5432
PGUSER=boredgames
PGPASSWORD=boredgames
PGDATABASE=boredgames